{
    "compilerOptions": {
        "allowJs": true,
        "target": "ES2022",
        "module": "ES2022",
        "declaration": false,
        "declarationMap": false,
        "moduleResolution": "node",
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": false,
        "outDir": "./dist",
        "baseUrl": "./",
        "rootDir": "./",
        "incremental": true,
        "skipLibCheck": true,
        "paths": {
            "@constants/*": ["src/constants/*"],
            "@config/*": ["src/config/*"],
            "@enums/*": ["src/enums/*"],
            "@flows/*": ["src/flows/*"],
            "@custom-types/*": ["src/types/*"],
            "@utils/*": ["src/utils/*"]
        }
    },
    "include": ["**/*.js", "**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**e2e**",
        "**mock**"
    ]
}
